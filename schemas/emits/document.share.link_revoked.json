{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "document.share.link_revoked",
  "description": "A bearer share link was revoked; every later presentation of it is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_by",
    "document_id",
    "expires_at",
    "level",
    "link_id",
    "status",
    "workspace_id"
  ],
  "properties": {
    "link_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "view",
        "edit"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
