{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "document.share.granted",
  "description": "A whitelist grant was created (or its level raised) on one document. Names the subject; never a bearer secret.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "access_id",
    "document_id",
    "granted_by",
    "level",
    "subject",
    "subject_kind",
    "workspace_id"
  ],
  "properties": {
    "access_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "subject_kind": {
      "type": "string",
      "enum": [
        "user",
        "ref"
      ]
    },
    "subject": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "view",
        "edit"
      ]
    },
    "granted_by": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
