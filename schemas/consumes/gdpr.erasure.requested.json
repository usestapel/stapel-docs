{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gdpr.erasure.requested",
  "description": "An erasure was opened for one subject (stapel-gdpr 0.5.0). stapel-docs answers for subject_type account | workspace | document and ignores the rest; the answer is gdpr.section.erased with the same correlation_id.",
  "type": "object",
  "required": ["request_id", "correlation_id", "subject_type", "subject_key"],
  "properties": {
    "request_id":     { "type": "integer" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "subject_type":   { "type": "string", "examples": ["account", "workspace", "document"] },
    "subject_key":    { "type": "string" },
    "workspace_id":   { "type": "string" },
    "requested_by":   { "type": "string" },
    "origin":         { "type": "string", "enum": ["user", "dsar", "inactivity", "restore_requeue", "admin"] },
    "due_at":         { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
